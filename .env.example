# Vercel Blob — 投票/收藏存储（生产必填；本地留空则回退 data/kv-store.json）
# 本地可写入 .env.local（自动加载，系统/CI 变量优先）；BLOB_SKILLS_READ_WRITE_TOKEN 作为别名等效
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here

# 本地强制使用 Vercel Blob（可选；生产 VERCEL=1 时自动启用）
# USE_BLOB=1

# 通用文件 API 写操作令牌（上传/列举/删除；生产 VERCEL=1 时必填，本地留空保持零配置）
FILE_API_TOKEN=

# Google Analytics 4 衡量 ID（可选，缺省回退 G-WQDDVB14PF）
GA_MEASUREMENT_ID=
