# skills/ 目录专属忽略规则
# 注意：本文件仅覆盖 skills/ 范围内的临时/运行时/依赖文件。
# 切勿使用 *.mjs / *.txt / *.md 这类宽泛通配——会误伤技能自带的
# LICENSE.txt、scripts/*.mjs（技能脚本，属交付内容）与技能文档。

# OS 生成文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp

# 本地工具状态（skills-manager 运行时数据，非源码，禁止入库）
.skills-manager.lock
.skills-manager/
skills-manager.db
skills-manager.db-shm
skills-manager.db-wal

# skills-manager / 工具缓存目录
cache/
logs/
scenarios/

# skills-manager 误写入的嵌套副本，非源码
skills/

# Python 编译缓存
__pycache__/
*.pyc

# Node 依赖
node_modules/

# 密钥 / 凭证（禁止入库）
.secret.key
.env
.env.local
*.ffs_db

# FreeFileSync 残留临时目录（非源码，禁止入库）
RecycleBin~*.ffs_tmp/
