# OS 生成文件
.DS_Store
Thumbs.db
cache/
logs/

# 临时文件
*.tmp

# FreeFileSync 残留临时目录（非源码，禁止入库）
skills/RecycleBin~*.ffs_tmp/

# 本地工具状态（skills-manager 运行时数据，非源码，禁止入库）
.skills-manager.lock
.skills-manager/
skills-manager.db
skills-manager.db-shm
skills-manager.db-wal

# skills-manager 误写入 skills/ 的整份仓库嵌套副本，非源码
skills/skills/

# 本地 Agent 记忆
.codebuddy/
# 本地 WorkBuddy 协作状态目录（类比 .codebuddy，非源码禁止入库）
.workbuddy/

# 本地脚本（不属于技能内容）
tools/*.ps1

# skills-manager / 工具缓存目录
skills/cache/
skills/logs/
skills/scenarios/

# Python 编译缓存
__pycache__/
*.pyc

# Node 依赖与构建产物（prototype 静态展示原型）
node_modules/
prototype/node_modules/

# app/ 子项目（独立 Next.js 应用）：依赖与构建产物均不入库
app/node_modules/
app/.next/
# EO 以根目录(./)部署时复制出的根 .next（Next 构建产物，不入库）
.next/
# 注意：prototype/out/ 为预构建 HTML 高保真原型，属交付物，已入库（不忽略）
# 但 out/_next/ 是 Next.js 瞬时构建产物（哈希化 JS/CSS），每次 build 都会变更，应忽略
prototype/out/_next/
*.tsbuildinfo

# 密钥 / 凭证（禁止入库）
.secret.key
.env
.env.local
*.ffs_db

# 注意：切勿用 *.txt / *.mjs / *.md 这类宽泛通配忽略"临时脚本"，
# 会误伤技能 LICENSE.txt、next.config.mjs（部署必需）、skills/**/*.mjs（技能脚本）、技能文档。
# 改为仅精确忽略根目录下以下划线开头的临时脚本与各类日志。
_*.mjs
*.log

# 构建脚本（核心工具链，必须入库）：显式放行，避免上面规则误伤
!next.config.mjs
!tools/**/*.mjs
!tools/lib/
!tools/lib/*.mjs
!prototype/build-skills-data.mjs
# 技能自带脚本与许可证、文档均为交付内容，必须入库
!skills/**/*.mjs
!skills/**/*.txt
!skills/**/*.md
