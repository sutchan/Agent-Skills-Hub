# OS 生成文件
.DS_Store
Thumbs.db
cache/
logs/

# 临时文件
*.tmp

# FreeFileSync 残留临时目录（非源码，禁止入库）
skills/RecycleBin~*.ffs_tmp/

# 本地工具状态（skills-manager 运行时数据，非源码，禁止入库）
.skills-manager.lock
.skills-manager/
skills-manager.db
skills-manager.db-shm
skills-manager.db-wal

# skills-manager 误写入 skills/ 的整份仓库嵌套副本，非源码
skills/skills/

# 本地 Agent 记忆
.codebuddy/

# 本地脚本（不属于技能内容）
tools/*.ps1

# skills-manager / 工具缓存目录
skills/cache/
skills/logs/
skills/scenarios/

# Python 编译缓存
__pycache__/
*.pyc

# Node 依赖与构建产物（prototype 静态展示原型）
node_modules/
prototype/node_modules/

# app/ 子项目（独立 Next.js 应用）：依赖与构建产物均不入库
app/node_modules/
app/.next/
# 注意：prototype/out/ 为预构建 HTML 高保真原型，属交付物，已入库（不忽略）
# 但 out/_next/ 是 Next.js 瞬时构建产物（哈希化 JS/CSS），每次 build 都会变更，应忽略
prototype/out/_next/
*.tsbuildinfo

# 密钥 / 凭证（禁止入库）
.secret.key
.env
.env.local
*.txt
*.ffs_db

# 构建脚本（核心工具链，必须入库）：放行根构建脚本与 CI 兼容转发层
# 其余 *.mjs 临时脚本默认忽略，避免污染
*.mjs
!build-skills-data.mjs
!build.mjs
!tools/build-skills-data.mjs
!tools/build.mjs
!tools/sync-tokens.mjs
!prototype/build-skills-data.mjs
!scripts/validate-skills.mjs
