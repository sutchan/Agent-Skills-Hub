{
  "name": "agent-skills-hub",
  "version": "1.16.31",
  "private": true,
  "description": "Agent Skills Hub — 高质量 agent 技能目录与高保真原型（纯静态站点）",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "npm run sync:data && node scripts/build-static.mjs && node scripts/inject-ga.mjs",
    "lint": "tsc --noEmit",
    "start": "node server.js",
    "sync:data": "node scripts/sync-inline-data.mjs && node scripts/sync-seo-assets.mjs",
    "sync:seo": "node scripts/sync-seo-assets.mjs",
    "render:og": "node scripts/render-og-image.mjs",
    "validate:yaml": "bun run tools/check-skill-yaml.mjs",
    "test": "node --test tools/lib/*.test.mjs",
    "tag": "node scripts/tag-release.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11 <25"
  }
}
